# Notehub personal access token.
# Create one at https://notehub.io -> user menu (top right) -> API Access -> Create New Token
NOTEHUB_PAT=

# Notehub project UID, from the project's Settings page. Looks like:
# app:00000000-0000-0000-0000-000000000000
NOTEHUB_PROJECT_UID=

# Optional. Pin the dashboard to one device instead of auto-selecting.
# Looks like: dev:000000000000000
NOTEHUB_DEVICE_UID=
